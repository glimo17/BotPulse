{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Synchronization": {
    "JobSync": {
      "Enabled": true,
      "IntervalSeconds": 120,
      "BatchSize": 500
    },
    "QueueItemSync": {
      "Enabled": true,
      "IntervalSeconds": 180,
      "BatchSize": 500
    },
    "LogSync": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "BatchSize": 500
    },
    "MetricsCollection": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "BatchSize": 100
    }
  }
}
