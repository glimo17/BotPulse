# BotPulse - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to source control

# ===== DATABASE =====
DB_PASSWORD=your_postgres_password_here
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=botpulse;Username=botpulse;Password=${DB_PASSWORD}

# ===== JWT =====
# Generate with: openssl rand -base64 32
Jwt__SigningKeyBase64=your_base64_signing_key_min_32_bytes
Jwt__Issuer=botpulse
Jwt__Audience=botpulse-api
Jwt__ExpirationMinutes=60

# ===== AUTHENTICATION =====
# Values: Local | EntraID | LDAP
Authentication__Provider=Local

# ===== UIPATH PROVIDER =====
# For development/demo: use demo credentials
# For production: change to your real Orchestrator URL
UiPath__BaseUrl=https://cloud.uipath.com/your_org
UiPath__Tenant=DefaultTenant
UiPath__ClientId=your_client_id_here
UiPath__ClientSecret=your_client_secret_here
UiPath__TimeoutSeconds=30

# ===== NOTIFICATIONS =====
# Values: SSE | Polling
Notifications__Transport=SSE

# ===== CACHE =====
# Values: Memory (MVP) | Redis (Phase 3)
Cache__Provider=Memory

# ===== SYNC INTERVALS (seconds, minimum 30) =====
Synchronization__JobSync__IntervalSeconds=120
Synchronization__QueueItemSync__IntervalSeconds=180
Synchronization__LogSync__IntervalSeconds=60
Synchronization__MetricsCollection__IntervalSeconds=300

# ===== CORS =====
Cors__AllowedOrigins=http://localhost:5173,https://localhost:5173
