# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

COPY ["src/BotPulse.Core/BotPulse.Core.csproj", "src/BotPulse.Core/"]
COPY ["src/BotPulse.Shared/BotPulse.Shared.csproj", "src/BotPulse.Shared/"]
COPY ["src/BotPulse.Infrastructure/BotPulse.Infrastructure.csproj", "src/BotPulse.Infrastructure/"]
COPY ["src/BotPulse.Providers.UiPath/BotPulse.Providers.UiPath.csproj", "src/BotPulse.Providers.UiPath/"]
COPY ["src/BotPulse.Providers.Demo/BotPulse.Providers.Demo.csproj", "src/BotPulse.Providers.Demo/"]
COPY ["src/BotPulse.Worker/BotPulse.Worker.csproj", "src/BotPulse.Worker/"]
COPY ["Directory.Packages.props", "./"]
COPY ["Directory.Build.props", "./"]

RUN dotnet restore "src/BotPulse.Worker/BotPulse.Worker.csproj"

COPY . .
RUN dotnet publish "src/BotPulse.Worker/BotPulse.Worker.csproj" -c Release -o /app/publish --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS runtime
WORKDIR /app

RUN addgroup -S botpulse && adduser -S botpulse -G botpulse

COPY --from=build /app/publish .
RUN chown -R botpulse:botpulse /app

USER botpulse

ENTRYPOINT ["dotnet", "BotPulse.Worker.dll"]
